<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GIVE ME THE TICKET</title>
    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="https://cdn-icons-png.flaticon.com/128/432/432312.png"
    />

    <!-- 부트스트랩 CSS CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"
      crossorigin="anonymous"
    />

    <!-- 부트스트랩 JS CDN -->
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"
      integrity="sha384-oBqDVmMz9ATKxIep9tiCxS/Z9fNfEXiDAYTujMAeBAsjFuCZSmKbSSUnQlmh/jp3"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"
      integrity="sha384-cuYeSxntonz0PPNlHhBs68uyIAVpIIOZZ5JqeqvYYIcEL727kskC66kF92t6Xl2V"
      crossorigin="anonymous"
    ></script>

    <!-- Axios CDN -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <!-- 공연 목록 페이지에 필요한 CSS 및 JS -->
    <link rel="stylesheet" href="/css/main/main.css" />
    <script type="module" src="/js/main/main.js"></script>
  </head>

  <body>
    <%- include('../common/header.view.ejs') %>
    <main class="py-4">
      <div class="container">
        <section class="popular-shows mb-4">
          <h5 class="mb-3">실시간 인기 공연 TOP 5</h5>
          <div id="rankedShowList" class="row"></div>
        </section>
        <div class="row mb-4 align-items-center">
          <div class="col-md-4">
            <input
              type="text"
              id="filterDate"
              class="form-control"
              placeholder="원하는 공연 날짜를 선택해주세요"
              onfocus="(this.type='date')"
              onblur="(this.type='text')"
            />
          </div>
          <div class="col-md-4 text-center">
            <div class="category-container">
              <button class="btn btn-outline-primary category-btn" data-category="Musical">
                뮤지컬
              </button>
              <button class="btn btn-outline-primary category-btn" data-category="Concert">
                콘서트
              </button>
              <button class="btn btn-outline-primary category-btn" data-category="Play">
                연극
              </button>
              <button class="btn btn-outline-secondary reset-btn" id="resetFilters">
                필터 해제
              </button>
            </div>
          </div>
          <div class="col-md-4 text-end">
            <div class="dropdown">
              <button
                class="btn btn-secondary dropdown-toggle"
                type="button"
                id="sortDropdown"
                data-bs-toggle="dropdown"
                aria-expanded="false"
              >
                정렬 기준
              </button>
              <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                <li><a class="dropdown-item" href="#" data-value="createdAt">최신순</a></li>
                <li><a class="dropdown-item" href="#" data-value="views">조회순</a></li>
                <li><a class="dropdown-item" href="#" data-value="bookings">예매순</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div id="showList" class="row"></div>
        <nav aria-label="Page navigation">
          <ul class="pagination justify-content-center mt-4" id="pagination"></ul>
        </nav>
      </div>
    </main>
    <div class="container mt-5">
      <!-- Modal -->
      <div
        class="modal fade"
        id="contentModal"
        tabindex="-1"
        aria-labelledby="contentModalLabel"
        aria-hidden="true"
      >
        <div class="modal-dialog modal-xl">
          <!-- 변경된 부분 -->
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="contentModalLabel">사이트 이용 안내</h5>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body">
              <div class="row">
                <div class="col-4">
                  <div id="list-example" class="list-group">
                    <a class="list-group-item list-group-item-action" href="#list-item-1"
                      >예매 안내</a
                    >
                    <a class="list-group-item list-group-item-action" href="#list-item-2"
                      >중고거래 등록 안내</a
                    >
                    <a class="list-group-item list-group-item-action" href="#list-item-3"
                      >중고 거래 구매 안내</a
                    >
                    <a class="list-group-item list-group-item-action" href="#list-item-4"
                      >환불 안내</a
                    >
                  </div>
                </div>
                <div class="col-8">
                  <div
                    data-bs-spy="scroll"
                    data-bs-target="#list-example"
                    data-bs-smooth-scroll="true"
                    class="scrollspy-example"
                    tabindex="0"
                    style="height: 500px; width: 700px; overflow-y: scroll"
                  >
                    <h4 id="list-item-1">공연 예매 안내</h4>
                    <img
                      src="https://d3pbkwvgb6ktnr.cloudfront.net/ticketing/2024-8-20_87692492.png"
                      alt="공연 예매"
                      class="img-full-width"
                    />
                    <h4 id="list-item-2">공연 환불 안내</h4>
                    <img
                      src="https://d3pbkwvgb6ktnr.cloudfront.net/ticketing/2024-8-20_45216031.png"
                      alt="공연 환불"
                      class="img-full-width"
                    />
                    <h4 id="list-item-3">중고 거래 등록 안내</h4>
                    <img
                      src="https://d3pbkwvgb6ktnr.cloudfront.net/ticketing/2024-8-20_25428238.png"
                      alt="중고 거래 등록"
                      class="img-full-width"
                    />
                    <h4 id="list-item-4">중고 거래 구매 안내</h4>
                    <img
                      src="https://d3pbkwvgb6ktnr.cloudfront.net/ticketing/2024-8-20_88521407.png"
                      alt="환불 안내"
                      class="img-full-width"
                    />
                  </div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" id="dontShowAgainBtn">닫기</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <footer class="text-center py-4">
      <p>&copy; 2024 GIVE ME THE TICKET. All Rights Reserved.</p>
    </footer>
  </body>
</html>
